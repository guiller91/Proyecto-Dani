{
  "name": "misterplan/reservas",
  "description": "Gestión de reservas en PHP nativo, Twig y MySQL.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*",
    "twig/twig": "^3.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {"psr-4": {"App\\": "src/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "serve": "php -S 127.0.0.1:8080 -t public public/router.php",
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=512M",
    "style": "php-cs-fixer fix --dry-run --diff --sequential",
    "lint": "@php bin/lint.php",
    "check": ["@lint", "@test", "@analyse", "@style"]
  },
  "config": {"sort-packages": true, "platform": {"php": "8.3.0"}, "allow-plugins": {}}
}
