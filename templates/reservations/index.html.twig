{% extends 'base.html.twig' %}
{% block title %}Reservas{% endblock %}
{% block content %}
<section id="reservations-page" aria-labelledby="page-title">
    <div class="page-heading">
        <div>
            <p class="eyebrow">Recepción / Reservas</p>
            <h1 id="page-title">Reservas</h1>
            <p class="subtitle">Consulta las estancias y gestiona su estado.</p>
        </div>
        <button class="button button-primary" id="open-create" type="button"><span aria-hidden="true">＋</span> Nueva reserva</button>
    </div>
    <div class="stats" aria-label="Resumen de las reservas filtradas">
        <article class="stat-card">
            <div class="stat-top"><h2>Reservas</h2></div>
            <div class="stat-value" id="stat-total">{{ summary.total }}</div>
            <p>En la selección</p>
        </article>
        <article class="stat-card">
            <div class="stat-top"><h2>Confirmadas</h2></div>
            <div class="stat-value" id="stat-confirmed">{{ summary.confirmadas }}</div>
            <p>Con estancia confirmada</p>
        </article>
        <article class="stat-card">
            <div class="stat-top"><h2>Pendientes</h2></div>
            <div class="stat-value" id="stat-pending">{{ summary.pendientes }}</div>
            <p>Por confirmar</p>
        </article>
        <article class="stat-card stat-money">
            <div class="stat-top"><h2>Importe activo</h2></div>
            <div class="stat-value" id="stat-amount">{{ summary.importe_activo|number_format(2, ',', '.') }} <span>€</span></div>
            <p>Sin incluir reservas canceladas</p>
        </article>
    </div>
    <section class="reservations-panel" aria-labelledby="list-title">
        <div class="panel-heading">
            <div>
                <h2 id="list-title">Registro de reservas <span id="result-count" class="count-pill">{{ meta.total }}</span></h2>
            </div>
            <span id="loading-indicator" class="loading-label" role="status" hidden><span class="spinner" aria-hidden="true"></span> Actualizando…</span>
        </div>
        <form id="filters" class="filters" action="/" method="get">
            <div class="filter-search">
                <label for="search">Buscar huésped</label>
                <div class="input-icon">
                    <input id="search" type="search" name="q" placeholder="Nombre del huésped…" maxlength="120" value="{{ filters.search }}">
                </div>
            </div>
            <div>
                <label for="status">Estado</label>
                <select name="estado" id="status">
                    <option value="">Todos los estados</option>
                    {% for status in ['pendiente','confirmada','cancelada'] %}
                        <option value="{{ status }}"{% if filters.status and filters.status.value == status %} selected{% endif %}>{{ status|capitalize }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="from">Estancias desde</label>
                <input type="date" id="from" name="desde" value="{{ filters.from }}" min="1000-01-01" max="9999-12-31">
            </div>
            <div>
                <label for="to">Hasta</label>
                <input type="date" id="to" name="hasta" value="{{ filters.to }}" min="1000-01-01" max="9999-12-31">
            </div>
            <button class="button button-secondary filter-submit" type="submit">Aplicar filtros</button>
            <button class="reset-button" id="reset-filters" type="button" title="Limpiar filtros" aria-label="Limpiar filtros">↺</button>
            <input type="hidden" name="per_page" value="{{ filters.perPage }}">
        </form>
        <p class="filter-hint">El intervalo muestra las estancias que coinciden con las fechas seleccionadas.</p>
        <div id="list-error" class="list-error" role="alert" hidden></div>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Tabla de reservas, desplazable horizontalmente">
            <table>
                <caption class="sr-only">Reservas de alojamiento</caption>
                <thead>
                    <tr>
                        <th scope="col">Reserva</th>
                        <th scope="col">Huésped</th>
                        <th scope="col">Alojamiento</th>
                        <th scope="col">Entrada <span aria-hidden="true">→</span> Salida</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="amount">Importe</th>
                        <th scope="col"><span class="sr-only">Acciones</span></th>
                    </tr>
                </thead>
                <tbody id="reservation-rows">
                    {% include 'reservations/_rows.html.twig' %}
                </tbody>
            </table>
        </div>
        <div class="pagination">
            <p id="pagination-summary">
                {% if meta.total %}
                    Mostrando {{ (meta.page - 1) * meta.per_page + 1 }}–{{ min(meta.page * meta.per_page, meta.total) }} de {{ meta.total }} reservas
                {% else %}
                    0 reservas
                {% endif %}
            </p>
            <nav aria-label="Paginación">
                <button id="previous-page" type="button" class="page-button"{% if meta.page <= 1 %} disabled{% endif %} aria-label="Página anterior">←</button>
                <span id="page-number" data-page="{{ meta.page }}">{{ meta.page }} / {{ meta.last_page }}</span>
                <button id="next-page" type="button" class="page-button"{% if meta.page >= meta.last_page %} disabled{% endif %} aria-label="Página siguiente">→</button>
            </nav>
        </div>
    </section>
</section>
{% endblock %}
{% block dialogs %}{% include 'reservations/_create.html.twig' %}{% endblock %}
