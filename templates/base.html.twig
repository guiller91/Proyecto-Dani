<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="{{ csrf_token }}">
    <meta name="app-timezone" content="{{ app_timezone }}">
    <meta name="description" content="Registro y gestión de reservas de alojamiento.">
    <title>{% block title %}Reservas{% endblock %} · Estancia</title>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/assets/app.css">
    <script src="/assets/app.js" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Saltar al contenido</a>
<header class="topbar">
    <a class="brand" href="/" aria-label="Estancia, inicio">Estancia<span class="brand-caption">Recepción</span></a>
    <nav aria-label="Navegación principal"><a class="nav-link active" href="/" aria-current="page">Reservas</a></nav>
    <span class="workspace-label">Gestión de alojamientos</span>
</header>
<main id="main" class="main" tabindex="-1">{% block content %}{% endblock %}</main>
<footer class="footer"><span>Estancia <span class="footer-divider">/</span> Registro de reservas</span><span>Fechas y horas · {{ app_timezone }}</span></footer>
<div id="notification" class="notification" role="status" aria-live="polite" hidden></div>
<dialog id="confirm-dialog" class="modal modal-small" aria-labelledby="confirm-title">
    <form method="dialog" id="confirm-form">
        <div class="modal-symbol danger-symbol" aria-hidden="true">!</div>
        <h2 id="confirm-title">¿Cancelar esta reserva?</h2>
        <p id="confirm-description">La reserva quedará cancelada y el cambio se guardará en su historial. Esta acción no se puede deshacer.</p>
        <p id="confirm-error" class="form-error" role="alert" hidden></p>
        <div class="modal-actions"><button class="button button-secondary" value="close" type="button" data-close-dialog>Volver</button><button class="button button-danger" id="confirm-action" type="submit">Sí, cancelar reserva</button></div>
    </form>
</dialog>
{% block dialogs %}{% endblock %}
</body>
</html>
