{% extends 'base.html.twig' %}
{% block title %}{{ status }}{% endblock %}
{% block content %}<section class="error-page"><p class="eyebrow">{{ status }}</p><h1>{{ status == 404 ? 'Aquí no hay una estancia.' : 'Algo no ha ido como esperábamos.' }}</h1><p>{{ message }}</p><a class="button button-primary" href="/">Volver a reservas →</a><p class="error-reference">Referencia: {{ request_id }}</p></section>{% endblock %}
